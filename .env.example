# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Core ---
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Database ---
# Leave DB_ENGINE unset (or "sqlite") for local development.
# Set DB_ENGINE=mysql on shared hosting (Hostinger/Bluehost/any cPanel host)
# once you've created a MySQL database + user in cPanel.
DB_ENGINE=mysql
DB_NAME=yourcpanelusername_ccms
DB_USER=yourcpanelusername_ccmsuser
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=localhost
DB_PORT=3306

# --- Security (production only; both default to True automatically when DEBUG=False) ---
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- SMS gateway ---
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=CCMS
